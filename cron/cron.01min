#!/bin/sh
# Abfuhrkalender AWM - minutlicher Cron (Abruf-Intervall, Ansage-Zeitpunkt, MQTT)
# REPLACELBPHTMLDIR wird bei der Installation durch den Plugin-HTML-Pfad ersetzt.
#
# Die Fehlerausgabe geht NICHT nach /dev/null: ein Fatal nach einem
# PHP-Upgrade oder ein dauerhaft klemmender Lauf waere sonst unsichtbar - zu
# sehen waere nur, dass sich in Loxone nichts mehr aendert. Die normale
# Ausgabe ("OK" oder "BUSY") bleibt draussen, sonst schriebe der Cron jede
# Minute eine Zeile.
#
# Kein fester Systempfad als Rueckfall: ist LBHOMEDIR nicht gesetzt oder der
# Protokollordner nicht da, bleibt es beim alten Weg. Ein Cron, der an seiner
# eigenen Umleitung scheitert, waere schlimmer als einer, der schweigt.
AWMLOGDIR=""
[ -n "$LBHOMEDIR" ] && AWMLOGDIR="$LBHOMEDIR/log/plugins/awmabfuhr"
if [ -n "$AWMLOGDIR" ] && [ -d "$AWMLOGDIR" ]; then
    php "REPLACELBPHTMLDIR/cron.php" >/dev/null 2>>"$AWMLOGDIR/cron_fehler.log"
else
    php "REPLACELBPHTMLDIR/cron.php" >/dev/null 2>&1
fi
